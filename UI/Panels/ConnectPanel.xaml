<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}" Width="920" Height="640" Padding="0">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Saved profiles -->
        <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="12,0,0,12">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Connections" Style="{StaticResource H2}" Margin="4,4,0,12"/>
                <ListBox x:Name="ProfileList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="12,9" Margin="0,2" BorderThickness="1" BorderBrush="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Surface}"/>
                                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Tenant}" FontSize="11.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding Warning}" FontSize="11" Foreground="{DynamicResource Warning}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="ProfileEmpty" Grid.Row="1" Text="No saved connections. Fill in the form, or let the assistant create an app for you." Style="{StaticResource Hint}" Margin="4,0" VerticalAlignment="Top"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="ProfileNew" Content="New" Margin="0,0,8,0"/>
                    <Button x:Name="ProfileDelete" Content="Delete" Style="{StaticResource SubtleBtn}" Foreground="{DynamicResource Danger}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right side -->
        <Grid Grid.Column="1" Margin="26,20,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Border Style="{StaticResource SegmentHost}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabExisting" Content="I have an app registration" Style="{StaticResource Segment}" GroupName="ct" IsChecked="True"/>
                        <RadioButton x:Name="TabSetup" Content="Create one for me" Style="{StaticResource Segment}" GroupName="ct"/>
                    </StackPanel>
                </Border>
                <Button x:Name="ConnClose" Style="{StaticResource SubtleBtn}" HorizontalAlignment="Right" Content="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
            </Grid>

            <!-- ===== Existing app ===== -->
            <ScrollViewer x:Name="FormPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                <StackPanel Margin="0,0,8,0">
                    <Grid Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,180,0" VerticalAlignment="Center"
                                   Text="Open the app registration in the Entra admin center, copy the Overview page and paste it here to fill in the IDs."/>
                        <Button x:Name="ConnPaste" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77F;" Style="{StaticResource Icon}" FontSize="13"/><TextBlock Text="Paste from Entra" Margin="8,0,0,0"/></StackPanel>
                        </Button>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Display name" Style="{StaticResource Label}"/>
                            <TextBox x:Name="ConnName" ToolTip="Any name, for example 'Contoso production'"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tenant ID or domain" Style="{StaticResource Label}"/>
                            <TextBox x:Name="ConnTenant"/>
                            <TextBlock x:Name="ConnTenantHint" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Application (client) ID" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                    <TextBox x:Name="ConnClient"/>
                    <TextBlock x:Name="ConnClientHint" Style="{StaticResource Hint}" Margin="0,3,0,0"/>

                    <TextBlock Text="Sign in with" Style="{StaticResource Label}" Margin="0,14,0,6"/>
                    <Border Style="{StaticResource SegmentHost}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ConnAuthCert" Content="Certificate (recommended)" Style="{StaticResource Segment}" GroupName="auth" IsChecked="True"/>
                            <RadioButton x:Name="ConnAuthSecret" Content="Client secret" Style="{StaticResource Segment}" GroupName="auth"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="SecretPanel" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock Text="Client secret value" Style="{StaticResource Label}"/>
                        <PasswordBox x:Name="ConnSecret"/>
                        <TextBlock x:Name="ConnSecretHint" Style="{StaticResource Hint}" Margin="0,3,0,0"
                                   Text="Paste the secret VALUE shown once when the secret was created (not the Secret ID). It is encrypted for your Windows account."/>
                    </StackPanel>

                    <StackPanel x:Name="CertPanel" Margin="0,12,0,0">
                        <TextBlock Text="Certificate from your certificate store" Style="{StaticResource Label}"/>
                        <Grid>
                            <ComboBox x:Name="ConnCertList" DisplayMemberPath="Display" Margin="0,0,92,0"/>
                            <Button x:Name="ConnCertRefresh" Content="Refresh" HorizontalAlignment="Right" Width="84"/>
                        </Grid>
                        <TextBlock Text="or a .pfx file" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ConnPfxPath"/>
                            <Button x:Name="ConnPfxBrowse" Grid.Column="1" Content="Browse" Margin="8,0"/>
                            <PasswordBox x:Name="ConnPfxPassword" Grid.Column="2" ToolTip="PFX password"/>
                        </Grid>
                    </StackPanel>

                    <CheckBox x:Name="ConnAdvanced" Content="Show advanced options" Margin="0,14,0,0"/>
                    <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock Text="Cloud" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="ConnCloud" Width="260" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- Test result -->
                    <Border x:Name="ConnResult" Margin="0,16,0,0" CornerRadius="8" Padding="14,12" Background="{DynamicResource SurfaceAlt}" Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ConnResultIcon" Style="{StaticResource Icon}" FontSize="16"/>
                                <TextBlock x:Name="ConnResultText" TextWrapping="Wrap" Margin="10,0,0,0" MaxWidth="540" FontWeight="SemiBold"/>
                            </StackPanel>
                            <ItemsControl x:Name="ConnPerms" Margin="26,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2" ToolTip="{Binding Detail}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding AuthType}" Style="{StaticResource Icon}" FontSize="11" Foreground="{Binding Warning}"/>
                                            <TextBlock Grid.Column="1" FontSize="12">
                                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                                <Run Text="{Binding Tenant, Mode=OneWay}" Foreground="{DynamicResource Muted}"/>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Setup assistant ===== -->
            <ScrollViewer x:Name="SetupPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Create an app registration automatically" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,6,0,14"
                               Text="Sign in once with an administrator account (Global Administrator, Privileged Role Administrator or Cloud Application Administrator). The assistant then:"/>
                    <StackPanel Margin="4,0,0,14">
                        <TextBlock Text="1.  Creates an app registration in your tenant" Margin="0,2"/>
                        <TextBlock Text="2.  Adds the Microsoft Graph permissions this tool needs and grants admin consent" Margin="0,2"/>
                        <TextBlock Text="3.  Creates a certificate in your personal store (or a client secret)" Margin="0,2"/>
                        <TextBlock Text="4.  Saves a connection profile, ready to use" Margin="0,2"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="App name" Style="{StaticResource Label}"/>
                            <TextBox x:Name="SetupName" Text="IntuneManager"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Cloud" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="SetupCloud"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Credential" Style="{StaticResource Label}" Margin="0,12,0,6"/>
                    <Border Style="{StaticResource SegmentHost}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="SetupCert" Content="Certificate (recommended)" Style="{StaticResource Segment}" GroupName="sc" IsChecked="True"/>
                            <RadioButton x:Name="SetupSecret" Content="Client secret (12 months)" Style="{StaticResource Segment}" GroupName="sc"/>
                        </StackPanel>
                    </Border>
                    <CheckBox x:Name="SetupOptional" Margin="0,12,0,0" IsChecked="True" Content="Also add Conditional Access, Windows 365, terms of use and branding permissions"/>

                    <Border x:Name="SetupCodePanel" Margin="0,16,0,0" CornerRadius="10" Padding="18" Background="{DynamicResource AccentSoft}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Sign in with an administrator account" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10" Text="Open the sign-in page and enter this code. This window continues automatically."/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="SetupCode" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="26" FontWeight="SemiBold" Width="230" Padding="12,6" HorizontalContentAlignment="Center"/>
                                <Button x:Name="SetupOpen" Style="{StaticResource AccentBtn}" Content="Copy code and open sign-in page" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ProgressBar x:Name="SetupProgress" IsIndeterminate="True" Margin="0,14,0,0" Visibility="Collapsed"/>
                    <ItemsControl x:Name="SetupLog" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource Success}"/>
                                    <TextBlock Text="{Binding}" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="540"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="SetupError" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <StackPanel x:Name="FormButtons" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ConnTest" Content="Test" Margin="0,0,8,0"/>
                    <Button x:Name="ConnSave" Content="Save" Margin="0,0,8,0"/>
                    <Button x:Name="ConnConnect" Content="Save and connect" Style="{StaticResource AccentBtn}" Padding="20,8"/>
                </StackPanel>
                <StackPanel x:Name="SetupButtons" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                    <Button x:Name="SetupCancel" Content="Cancel" Margin="0,0,8,0" Visibility="Collapsed"/>
                    <Button x:Name="SetupStart" Content="Start" Style="{StaticResource AccentBtn}" Padding="22,8"/>
                    <Button x:Name="SetupConnect" Content="Connect now" Style="{StaticResource AccentBtn}" Padding="22,8" Visibility="Collapsed"/>
                </StackPanel>
                <TextBlock x:Name="ConnBusy" Text="Signing in..." Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</Border>
