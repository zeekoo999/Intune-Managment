<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}" Width="500">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="ConfIcon" Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource Warning}" Margin="0,0,12,0"/>
            <TextBlock x:Name="ConfTitle" Style="{StaticResource H2}" TextWrapping="Wrap" MaxWidth="420"/>
        </StackPanel>
        <TextBlock x:Name="ConfText" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource Muted}"/>
        <StackPanel x:Name="ConfInputPanel" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ConfInputLabel" Style="{StaticResource Label}"/>
            <TextBox x:Name="ConfInput"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="ConfCancel" Content="Cancel" Margin="0,0,8,0"/>
            <Button x:Name="ConfOk" Content="OK" Style="{StaticResource AccentBtn}" Padding="22,8"/>
        </StackPanel>
    </StackPanel>
</Border>
