<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}" Width="1100" Height="700" Padding="0">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Plan -->
        <Grid Margin="24,20,18,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Import" Style="{StaticResource H1}"/>
                <TextBlock x:Name="ImpSub" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <TextBox x:Name="ImpPath" Margin="0,0,180,0" ToolTip="Export folder (contains manifest.json or object type folders)"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ImpBrowse" Content="Browse" Width="84" Margin="0,0,8,0"/>
                    <Button x:Name="ImpLoad" Content="Load" Width="84"/>
                </StackPanel>
            </Grid>
            <Border x:Name="ImpSourceInfo" Grid.Row="2" Margin="0,10,0,0" Background="{DynamicResource SurfaceAlt}" CornerRadius="8" Padding="12,8" Visibility="Collapsed">
                <Grid>
                    <TextBlock x:Name="ImpSourceText" TextWrapping="Wrap" Margin="0,0,260,0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Grid Width="170" Margin="0,0,8,0">
                            <TextBox x:Name="ImpFilter" Padding="28,5,8,5"/>
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="9,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                        <Button x:Name="ImpSelAll" Content="All" Style="{StaticResource SubtleBtn}"/>
                        <Button x:Name="ImpSelNone" Content="None" Style="{StaticResource SubtleBtn}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="3" Margin="0,10,0,0" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <DataGrid x:Name="ImpGrid" Margin="2">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="40" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="48" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeTitle}" Width="170" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Assign." Binding="{Binding Assignments}" Width="60" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Status" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="p" Style="{StaticResource Pill}">
                                            <TextBlock x:Name="t" Text="{Binding Status}" FontSize="11.5"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value=""><Setter TargetName="p" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter TargetName="t" Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Invalid"><Setter TargetName="t" Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Warning"><Setter TargetName="t" Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Success"><Setter TargetName="t" Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Skipped"><Setter TargetName="t" Property="Foreground" Value="{DynamicResource Muted}"/></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Details" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Message}" ToolTip="{Binding Message}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel x:Name="ImpEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}" FontSize="34" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Choose an export folder and click Load." Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
                        <TextBlock Text="Exports from the original IntuneManagement tool work too." Style="{StaticResource Hint}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock x:Name="ImpSummary" Grid.Row="4" Margin="0,10,0,0" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
        </Grid>

        <!-- Options -->
        <Border Grid.Column="1" Background="{DynamicResource SurfaceAlt}" CornerRadius="0,12,12,0">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="Options" Style="{StaticResource H2}"/>
                    <Button x:Name="ImpClose" Style="{StaticResource SubtleBtn}" HorizontalAlignment="Right" Content="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="When an object with the same name exists" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="ImpConflict" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        <TextBlock x:Name="ImpConflictHint" Style="{StaticResource Hint}" Margin="0,4,0,0"/>

                        <CheckBox x:Name="ImpAssign" Content="Import assignments" Margin="0,16,0,0" IsChecked="True"/>
                        <CheckBox x:Name="ImpCreateGroups" Content="Create missing groups" Margin="0,10,0,0" IsChecked="True"/>
                        <CheckBox x:Name="ImpScopeTags" Content="Keep scope tags" Margin="0,10,0,0" IsChecked="True"/>

                        <TextBlock Text="Name prefix (optional)" Style="{StaticResource Label}" Margin="0,16,0,4"/>
                        <TextBox x:Name="ImpPrefix" ToolTip="Added in front of every imported name, e.g. 'TEST - '"/>

                        <TextBlock Text="Conditional Access policies import as" Style="{StaticResource Label}" Margin="0,16,0,4"/>
                        <ComboBox x:Name="ImpCaState" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                        <Border Margin="0,18,0,0" CornerRadius="8" Padding="12" Background="{DynamicResource Surface}">
                            <TextBlock Style="{StaticResource Hint}" Text="Tip: run Preview first. It checks every file, resolves groups and dependencies and shows exactly what would be created, updated or skipped, without changing anything."/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2">
                    <Button x:Name="ImpRetry" Content="Retry failed" Margin="0,0,0,8" Visibility="Collapsed" HorizontalAlignment="Stretch"/>
                    <Button x:Name="ImpReport" Content="Open report" Margin="0,0,0,8" Visibility="Collapsed" HorizontalAlignment="Stretch"/>
                    <Button x:Name="ImpPreview" Content="Preview (no changes)" Margin="0,0,0,8" HorizontalAlignment="Stretch" IsEnabled="False"/>
                    <Button x:Name="ImpStart" Content="Import" Style="{StaticResource AccentBtn}" HorizontalAlignment="Stretch" Padding="20,9" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Border>
