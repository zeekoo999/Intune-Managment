<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}" Width="680" MaxHeight="720">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="Settings" Style="{StaticResource H1}"/>
            <Button x:Name="SetClose" Style="{StaticResource SubtleBtn}" HorizontalAlignment="Right" VerticalAlignment="Top" Content="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Appearance" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                <Border Style="{StaticResource SegmentHost}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SetDark" Content="Dark" Style="{StaticResource Segment}" GroupName="th"/>
                        <RadioButton x:Name="SetLight" Content="Light" Style="{StaticResource Segment}" GroupName="th"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Microsoft Graph" Style="{StaticResource H2}" Margin="0,22,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="API version" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="SetGraphVer"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Retries on throttling/errors" Style="{StaticResource Label}"/>
                        <TextBox x:Name="SetRetries"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Request timeout (seconds)" Style="{StaticResource Label}"/>
                        <TextBox x:Name="SetTimeout"/>
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="beta is recommended: many Intune object types and properties exist only in beta."/>

                <TextBlock Text="Export and import defaults" Style="{StaticResource H2}" Margin="0,22,0,8"/>
                <TextBlock Text="Default export folder" Style="{StaticResource Label}"/>
                <Grid>
                    <TextBox x:Name="SetExportRoot" Margin="0,0,92,0"/>
                    <Button x:Name="SetExportBrowse" Content="Browse" HorizontalAlignment="Right" Width="84"/>
                </Grid>
                <CheckBox x:Name="SetContinue" Content="Continue importing when an object fails" Margin="0,12,0,0"/>
                <TextBlock Text="Rename suffix (conflict action Rename)" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                <TextBox x:Name="SetSuffix" Width="240" HorizontalAlignment="Left"/>

                <TextBlock Text="Logging" Style="{StaticResource H2}" Margin="0,22,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Log level" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="SetLogLevel"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Keep log files (days)" Style="{StaticResource Label}"/>
                        <TextBox x:Name="SetRetention"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Log folder" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                <Grid>
                    <TextBox x:Name="SetLogDir" Margin="0,0,92,0"/>
                    <Button x:Name="SetLogBrowse" Content="Browse" HorizontalAlignment="Right" Width="84"/>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Logs are written as text (.log) and structured JSON lines (.jsonl). Every Graph error includes its request-id and client-request-id for Microsoft support."/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="SetCancel" Content="Cancel" Margin="0,0,8,0"/>
            <Button x:Name="SetSave" Content="Save" Style="{StaticResource AccentBtn}" Padding="24,8"/>
        </StackPanel>
    </Grid>
</Border>
