<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}" Width="1140" Height="720">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Compare" Style="{StaticResource H1}"/>
                <TextBlock Text="Objects are matched by type and name. Volatile fields are ignored and assignments are compared by group name." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="CmpClose" Style="{StaticResource SubtleBtn}" HorizontalAlignment="Right" VerticalAlignment="Top" Content="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SegmentHost}" VerticalAlignment="Top">
                <StackPanel>
                    <RadioButton x:Name="CmpModeTenant" Content="Baseline vs this tenant" Style="{StaticResource Segment}" GroupName="cm" IsChecked="True"/>
                    <RadioButton x:Name="CmpModeExports" Content="Export vs export" Style="{StaticResource Segment}" GroupName="cm"/>
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Margin="18,0">
                <TextBlock Text="Reference (baseline export)" Style="{StaticResource Label}"/>
                <Grid>
                    <TextBox x:Name="CmpRef" Margin="0,0,92,0"/>
                    <Button x:Name="CmpRefBrowse" Content="Browse" HorizontalAlignment="Right" Width="84"/>
                </Grid>
                <StackPanel x:Name="CmpDiffRow" Visibility="Collapsed" Margin="0,8,0,0">
                    <TextBlock Text="Difference export" Style="{StaticResource Label}"/>
                    <Grid>
                        <TextBox x:Name="CmpDiff" Margin="0,0,92,0"/>
                        <Button x:Name="CmpDiffBrowse" Content="Browse" HorizontalAlignment="Right" Width="84"/>
                    </Grid>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox x:Name="CmpIgnoreAssign" Content="Ignore assignments" Margin="0,0,20,0"/>
                    <CheckBox x:Name="CmpOnlyType" Content="Only the current object type"/>
                </StackPanel>
            </StackPanel>
            <Button x:Name="CmpRun" Grid.Column="2" Content="Compare" Style="{StaticResource AccentBtn}" Padding="24,8" VerticalAlignment="Top" Margin="0,18,0,0"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource SegmentHost}" Margin="8,8,8,4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="CmpShowChanged" Content="Changes" Style="{StaticResource Segment}" GroupName="cf" IsChecked="True"/>
                            <RadioButton x:Name="CmpShowAll" Content="All" Style="{StaticResource Segment}" GroupName="cf"/>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="CmpGrid" Grid.Row="1" IsReadOnly="True" SelectionMode="Single" Margin="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeTitle}" Width="*"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.4*"/>
                            <DataGridTemplateColumn Header="Status" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="t" Text="{Binding StatusText}" VerticalAlignment="Center"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Different"><Setter TargetName="t" Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="OnlyInReference"><Setter TargetName="t" Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="OnlyInDifference"><Setter TargetName="t" Property="Foreground" Value="{DynamicResource Info}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Identical"><Setter TargetName="t" Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="2" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <DataGrid x:Name="CmpDiffGrid" IsReadOnly="True" Margin="2" RowHeight="NaN">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Property" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Property}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Margin="0,5"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Reference" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Reference}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Margin="0,5"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Difference" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Difference}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Margin="0,5"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="CmpDiffEmpty" Text="Select a changed object to see its differences." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="CmpSummary" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CmpSaveCsv" Content="Save CSV" Margin="0,0,8,0" IsEnabled="False"/>
                <Button x:Name="CmpSaveHtml" Content="Save HTML report" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Border>
